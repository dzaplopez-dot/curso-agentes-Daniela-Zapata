  "properties": {
    "document_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "card_voucher",
        "transfer",
        "addi_credit",
        "sistecredito_credit",
        "expense",
        null
      ]
    },
    "payment_brand_or_medium": {
      "type": [
        "string",
        "null"
      ]
    },
    "payment_medium_alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "currency_observed": {
      "type": [
        "string",
        "null"
      ],
      "description": "Solo moneda explícita. No inferir COP de un logo."
    },
    "operation_status_observed": {
      "type": [
        "string",
        "null"
      ],
      "description": "Texto visible; no verifica autenticidad ni abono."
    },
    "amount_basis": {
      "type": "string",
      "enum": [
        "observed_total",
        "financed_value",
        "missing"
      ]
    },
    "total_amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "inferred_amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "stated_cash_amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "document_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "document_time": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$"
    },
    "time_precision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "minute",
        "second",
        null
      ]
    },
